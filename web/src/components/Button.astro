---
// A square, lowercase-verb button.
//
// - primary: aurora fill. One per screen.
// - secondary: outlined, for everything else.
// - text: green, underlined text, like a link in running text. For quiet places such as
//   the man page.
//
// The outline uses dim, not line-strong: a control's edge needs 3:1 against the page
// (WCAG 1.4.11), and line-strong is 1.7:1.
//
// With href it is a link that looks like a button, for actions that are a URL (the
// calendar file). With download as well, the browser saves the file under that name (the
// share image on your profile card). With newTab as well, it opens in a new tab (the door's
// Codespace, so the door page stays open next to it).
//
// Its look is in styles/controls.css, so a Vue island, which can't use Astro components, draws
// the same button with class="button button-primary" (or -secondary, -text).
import type { HTMLAttributes } from 'astro/types';
import '../styles/controls.css';

interface Props extends HTMLAttributes<'button'> {
  variant?: 'primary' | 'secondary' | 'text';
  href?: string;
  /** With href: save the file under this name instead of opening it. */
  download?: string;
  /** With href: open the link in a new tab. */
  newTab?: boolean;
}

const { variant = 'secondary', type = 'button', href, download, newTab = false, class: className, ...attributes } = Astro.props;
const classes = ['button', `button-${variant}`, className];
---

{href ? (
  <a
    class:list={classes}
    href={href}
    download={download}
    target={newTab ? '_blank' : undefined}
    rel={newTab ? 'noopener' : undefined}
    {...attributes}
  >
    <slot />
  </a>
) : (
  <button class:list={classes} type={type} {...attributes}>
    <slot />
  </button>
)}
