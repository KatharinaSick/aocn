---
// The station console's header on every page: POLARIS-7's mark and name on the left,
// the site navigation on the right, and who is logged in (see lib/account.ts).
import { doorOpensAt } from '../lib/doors';

// "doors" joins in December, when there are doors. Until then the logo leads home.
const links = [{ href: '/how-it-works', label: 'how it works' }];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

// Logging in shows up when door 1 opens, without a build: the script below compares the clock.
const loginOpensAt = doorOpensAt(1).toISOString();
---

<header class="siteHeader">
  <a class="siteHeaderBrand" href="/">
    <!-- Her header mark, the same drawing as the favicon: her neutral face with the heavy
         outline (the design's pola-mark has annoyed lids; we keep her neutral here, like on
         the landing page). The name next to it says who she is. -->
    <img class="siteHeaderMark" src="/favicon.svg" width="32" height="24" alt="" />
    <span class="siteHeaderName">POLARIS-7</span>{' '}
    <span class="siteHeaderSubtitle"><span aria-hidden="true">// </span>station console</span>
  </a>

  <nav class="siteHeaderNav" aria-label="main">
    {links.map((link) => (
      <a class="siteHeaderLink" href={link.href} aria-current={currentPath === link.href ? 'page' : undefined}>
        {link.label}
      </a>
    ))}
    <!-- Filled in by the script below; without it, nobody is logged in as far as the page knows. -->
    <a class="siteHeaderLink siteHeaderLogIn" href="/api/auth/github/login" data-opens-at={loginOpensAt} hidden>
      log in
    </a>
    <!-- Who is logged in, linking to their card, where they can log out. -->
    <a class="siteHeaderLink siteHeaderAccount" href="/" hidden><span class="siteHeaderAccountName"></span></a>
  </nav>
</header>

<script>
  import { accountAt, fetchMe, loginHref, profileHref } from '../lib/account';

  // Asked after the page is shown, so the page itself stays the same for everyone.
  const logIn = document.querySelector<HTMLAnchorElement>('.siteHeaderLogIn');
  const account = document.querySelector<HTMLAnchorElement>('.siteHeaderAccount');
  if (logIn && account) {
    const opensAt = new Date(logIn.dataset.opensAt ?? '');
    fetchMe().then((me) => {
      const shown = accountAt(me, new Date(), opensAt);
      if (shown.state === 'loggedIn') {
        account.querySelector('.siteHeaderAccountName')!.textContent = `@${shown.me.login}`;
        account.closest('.siteHeader')?.classList.add('siteHeaderLoggedIn');
        account.href = profileHref(shown.me.login);
        // Logins ignore case, so /u/octo is Octo's card too.
        if (window.location.pathname.replace(/\/$/, '').toLowerCase() === account.pathname.toLowerCase()) {
          account.setAttribute('aria-current', 'page');
        }
        account.hidden = false;
      } else if (shown.state === 'loggedOut') {
        logIn.href = loginHref(window.location.pathname);
        logIn.hidden = false;
      }
    });
  }

  // See-through only while nothing is underneath: at the very top the sky shows behind
  // the header as designed. Without this script the header simply stays solid.
  const header = document.querySelector('.siteHeader');
  const update = () => header?.classList.toggle('siteHeaderAtTop', window.scrollY <= 0);
  update();
  window.addEventListener('scroll', update, { passive: true });
</script>

<style>
  /* Sticky and solid, so nothing shows through while the page scrolls underneath.
     BaseLayout keeps focused elements clear of it. */
  .siteHeader {
    position: sticky;
    top: 0;
    z-index: 1;
    background: var(--color-panel);
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-6) var(--page-gutter);
    border-bottom: 1px solid var(--color-line);
  }

  .siteHeaderAtTop {
    background: transparent;
  }

  .siteHeaderBrand {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--color-text);
    text-decoration: none;
  }

  /* The favicon is drawn square; the mark itself is 4:3. */
  .siteHeaderMark {
    object-fit: cover;
  }

  .siteHeaderName {
    font-size: var(--font-size-wordmark);
    line-height: var(--line-height-wordmark);
    letter-spacing: var(--letter-spacing-wordmark);
    font-weight: var(--font-weight-bold);
  }

  .siteHeaderSubtitle {
    color: var(--color-muted);
  }

  .siteHeaderNav {
    display: flex;
    align-items: center;
    gap: var(--space-6);
  }

  .siteHeaderLink {
    color: var(--color-text);
    text-decoration: none;
  }

  .siteHeaderLink:hover,
  .siteHeaderLink[aria-current='page'] {
    color: var(--color-aurora);
  }

  .siteHeaderLink[aria-current='page'] {
    border-bottom: 1px solid var(--color-aurora);
  }

  /* The links' display would beat the hidden attribute. */
  .siteHeaderLogIn[hidden],
  .siteHeaderAccount[hidden] {
    display: none;
  }

  /* Mobile: her mark and name only, no subtitle, and the nav link is a full tap target. */
  @media (max-width: 799px) {
    /* When her name and the links don't fit on one row, the links move to a second one. */
    .siteHeader {
      flex-wrap: wrap;
      justify-content: space-between;
      column-gap: var(--space-6);
      padding-block: var(--space-4);
    }

    .siteHeaderNav {
      margin-left: auto;
    }

    .siteHeaderName {
      white-space: nowrap;
    }

    .siteHeaderSubtitle {
      display: none;
    }

    .siteHeaderLink {
      display: inline-flex;
      align-items: center;
      min-height: var(--size-touch);
      white-space: nowrap;
    }

    /* A long login would push the links onto a second row. */
    .siteHeaderAccountName {
      max-width: 12ch;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    /* A border would sit at the bottom of the 48px tap target, far below the word. */
    .siteHeaderLink[aria-current='page'] {
      border-bottom: none;
      text-decoration: underline;
      text-underline-offset: var(--space-1);
    }
  }

  /* The narrowest phones: her mark alone, so the links still fit on the same row. Moving them
     to a second row would push the page down over a brighter part of the sky. */
  @media (max-width: 359px) {
    .siteHeaderName {
      display: none;
    }
  }

  /* A login takes more room than "log in", so her name gives way on more phones. */
  @media (max-width: 439px) {
    .siteHeaderLoggedIn .siteHeaderName {
      display: none;
    }
  }
</style>
