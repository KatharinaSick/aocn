---
// POLARIS-7's pixel face in one of her moods. The geometry is the face asset set from
// the Station Console design, drawn on an 8-unit grid inside a 128 × 96 screen. Only
// the ink changes, and it comes from the mood's color token.
//
// Her eyes blink every 5 seconds; nothing else about her moves. The blink stops under
// prefers-reduced-motion.

import { eyes, mouths, sweat, type PolaMood } from '../lib/polaFace';

export type { PolaMood };
export type PolaFaceSize = 'small' | 'medium' | 'large' | 'xlarge';

interface Props {
  mood: PolaMood;
  /** small 32 × 24 (header, prompt line) · medium 48 × 36 (logs) · large 112 × 84 (cards) · xlarge 160 × 120 (finale). */
  size?: PolaFaceSize;
  /**
   * What a screen reader hears. Defaults to "POLARIS-7, <mood>". Pass null when the
   * surrounding text already says who she is and how she feels.
   */
  label?: string | null;
}

const { mood, size = 'small', label = `POLARIS-7, ${mood}` } = Astro.props;

const dimensions: Record<PolaFaceSize, [number, number]> = {
  small: [32, 24],
  medium: [48, 36],
  large: [112, 84],
  xlarge: [160, 120],
};

const [width, height] = dimensions[size];
// At 32 × 24 a 4-unit outline is one pixel and gets lost; the small size uses the
// heavier outline of the design's header mark.
const outline = size === 'small' ? { stroke: 8, rx: 10 } : { stroke: 4, rx: 8 };
---

<svg
  class:list={['polaFace', `polaFace-${mood}`]}
  width={width}
  height={height}
  viewBox="0 0 128 96"
  shape-rendering="crispEdges"
  {...label === null ? { 'aria-hidden': 'true' } : { role: 'img', 'aria-label': label }}
>
  <rect class="polaFaceScreen" x="4" y="4" width="120" height="88" rx={outline.rx} stroke-width={outline.stroke} />
  <g class="polaFaceEyes">
    {eyes[mood].map(([x, y, w, h]) => <rect x={x} y={y} width={w} height={h} />)}
  </g>
  {mouths[mood].map(([x, y, w, h]) => <rect x={x} y={y} width={w} height={h} />)}
  {mood === 'worried' && (
    <g class="polaFaceSweat">
      {sweat.map(([x, y, w, h]) => <rect x={x} y={y} width={w} height={h} />)}
    </g>
  )}
</svg>

<style>
  .polaFace {
    flex-shrink: 0;
    fill: currentColor;
  }

  .polaFace-neutral {
    color: var(--color-aurora);
  }

  .polaFace-annoyed {
    color: var(--color-signal);
  }

  .polaFace-worried {
    color: var(--color-violet);
  }

  .polaFace-fond {
    color: var(--color-warm);
  }

  .polaFaceScreen {
    fill: var(--color-bg);
    stroke: currentColor;
  }

  .polaFaceSweat {
    opacity: 0.6;
  }

  .polaFaceEyes {
    transform-box: fill-box;
    transform-origin: center;
    animation: polaFaceBlink 5s infinite;
  }

  @keyframes polaFaceBlink {
    0%,
    93%,
    100% {
      transform: scaleY(1);
    }
    95% {
      transform: scaleY(0.12);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .polaFaceEyes {
      animation: none;
    }
  }
</style>
