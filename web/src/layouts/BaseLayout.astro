---
// The shell every page renders in: document head, SEO and social preview tags, the
// font, the design tokens, the sky, the skip link, the header, POLARIS-7's prompt line
// and the footer.
import { Font } from 'astro:assets';
import type { PolaMood } from '../components/PolaFace.astro';
import PromptLine from '../components/PromptLine.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Sky from '../components/Sky.astro';
import VimKeys from '../components/VimKeys.vue';
import '../styles/base.css';

const SITE_NAME = 'Advent of Cloud Native';

interface Props {
  /** Page title. Omit on the landing page, which is titled by the site name alone. */
  title?: string;
  /** Meta and social preview description. Every page sets its own. */
  description: string;
  /**
   * Social preview image, 1200 × 630, as a path under public/ or an absolute URL. Defaults
   * to the site's own (scripts/social-image.ts draws it).
   */
  image?: { src: string; alt: string };
  /** Keep the page out of search results. */
  noindex?: boolean;
  /** POLARIS-7's line on this page: one sentence that fits it, in her mood of the day. */
  pola: { mood: PolaMood; message: string };
  /**
   * Keep the footer below the fold, so a page that almost fits the window never shows half
   * of it: POLARIS-7's line sits at the window's bottom edge, and the footer is one scroll
   * away. Off on the landing page, which is meant to fit on one screen, footer and all.
   */
  footerBelowFold?: boolean;
}

const DEFAULT_IMAGE = {
  src: '/social.png',
  alt: 'advent of cloud native: 12 CNCF projects, 12 broken things, one very tired station AI. POLARIS-7 under the aurora.',
};

const { title, description, image = DEFAULT_IMAGE, noindex = false, pola, footerBelowFold = true } = Astro.props;

const fullTitle = title ? `${title} · ${SITE_NAME}` : SITE_NAME;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image.src, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex" />}
    <!-- Browser chrome in the station's background color (--color-bg; a meta tag cannot read a token). -->
    <meta name="theme-color" content="#0a1114" />

    <!-- POLARIS-7's header mark. The PNG is for browsers without SVG favicons. -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={image.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image:alt" content={image.alt} />

    <!-- Page-specific head content, such as the landing page's structured data. -->
    <slot name="head" />

    <Font cssVariable="--font-mono" preload />

    {
      import.meta.env.COUNT_VISITS && (
        <script is:inline>
          // Visit counts (see /privacy). A cut-down copy of counter.dev's script
          // (https://github.com/ihucos/counter.dev, AGPL-3.0) that stores and reads
          // nothing on the device: no sessionStorage, no screen size, no cached response.
          // So a reload of the landing page counts as a new visit; that is the price.
          // The offset is CET, December's time zone, used to bucket visits by hour.
          (function () {
            var server = 'https://t.counter.dev';
            var id = 'f3711968-dc77-4762-b403-abbe686b0730';
            // A visit starts on a page not reached from aocn.dev itself. The delay is
            // counter.dev's: a tab closed within seconds is not counted as a visit.
            if (!document.referrer.startsWith(location.origin)) {
              setTimeout(function () {
                fetch(server + '/track?' + new URLSearchParams({ referrer: document.referrer, id: id, utcoffset: '1' }), {
                  cache: 'no-store',
                });
              }, 4500);
            }
            navigator.sendBeacon(server + '/trackpage', new URLSearchParams({ id: id, page: location.pathname }));
          })();
        </script>
      )
    }
  </head>
  <body class="baseLayout">
    <Sky />
    <a class="baseLayoutSkipLink" href="#main">skip to content</a>
    <div class:list={['baseLayoutScreen', { baseLayoutScreenFull: footerBelowFold }]}>
      <SiteHeader />
      <main class="baseLayoutMain" id="main" tabindex="-1">
        <slot />
      </main>
      <div class="baseLayoutPrompt">
        <PromptLine mood={pola.mood} message={pola.message} />
      </div>
    </div>
    <SiteFooter />
    <VimKeys client:idle />
    <script>
      // See-through only while nothing is underneath: once the footer starts right below
      // the prompt line, it rests in its own place and the sky shows behind it as designed.
      // Without this script it simply stays solid.
      const prompt = document.querySelector('.baseLayoutPrompt');
      const footer = document.querySelector('.siteFooter');
      const update = () => {
        if (!prompt || !footer) return;
        const atRest = footer.getBoundingClientRect().top <= prompt.getBoundingClientRect().bottom + 1;
        prompt.classList.toggle('baseLayoutPromptAtRest', atRest);
      };
      update();
      window.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update, { passive: true });
    </script>
  </body>
</html>

<style>
  /* The header is sticky. Anything scrolled into view (a #link target, a focused element)
     stops below it instead of underneath: its 24px padding twice plus one line of text. */
  :global(html) {
    scroll-padding-top: calc(2 * var(--space-6) + var(--space-8));
  }

  /* On mobile its padding is space-4 and its tallest item the nav link's tap target. */
  @media (max-width: 799px) {
    :global(html) {
      scroll-padding-top: calc(2 * var(--space-4) + var(--size-touch));
    }
  }

  /* The vim statusline is fixed to the bottom of the window while it shows; the page gets
     room for it so it never covers the footer. */
  :global(html.vimStatuslineShown) .baseLayout {
    padding-bottom: var(--size-statusline);
  }

  /* A stacking context of its own, so the sky (z-index -1) stays behind every page. */
  .baseLayout {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
  }

  /* Header, page and prompt line. Fills the body, so the prompt line and footer sit at the
     bottom even on a short page. */
  .baseLayoutScreen {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  /* At least one window tall without the footer (see footerBelowFold), so the footer always
     starts at or below the fold. svh, the window with the mobile address bar showing, so
     the prompt line is fully in view on load. Above the vim statusline while that shows. */
  .baseLayoutScreenFull {
    min-height: 100vh;
    min-height: 100svh;
  }

  :global(html.vimStatuslineShown) .baseLayoutScreenFull {
    min-height: calc(100vh - var(--size-statusline));
    min-height: calc(100svh - var(--size-statusline));
  }

  /* Fills the space between header and prompt line, so the prompt line sits at the bottom
     even on a short page. */
  .baseLayoutMain {
    flex: 1;
    /* A column, so a page can let its content grow into the free height (see the landing). */
    display: flex;
    flex-direction: column;
  }

  .baseLayoutPrompt {
    padding: 0 var(--page-gutter);
  }

  /* Desktop: POLARIS-7's line sticks to the bottom of the window like a terminal's status
     line, so she stays in view on a long page. It sits above the vim statusline while that
     shows. Solid while the page scrolls underneath, see-through once it rests in its own
     place above the footer (the script below). Anything scrolled into view stops above it:
     its 16px padding twice plus one line of text. On mobile it scrolls with the page: two
     pinned bars would leave too little room for the page itself. */
  @media (min-width: 800px) {
    :global(html) {
      scroll-padding-bottom: calc(2 * var(--space-4) + var(--space-8));
    }

    :global(html.vimStatuslineShown) {
      scroll-padding-bottom: calc(2 * var(--space-4) + var(--space-8) + var(--size-statusline));
    }

    .baseLayoutPrompt {
      position: sticky;
      bottom: 0;
      z-index: 1;
      background: var(--color-panel);
    }

    :global(html.vimStatuslineShown) .baseLayoutPrompt {
      bottom: var(--size-statusline);
    }

    .baseLayoutPromptAtRest {
      background: transparent;
    }
  }

  /* Above the sticky header. */
  .baseLayoutSkipLink {
    position: absolute;
    z-index: 2;
    top: var(--space-2);
    left: var(--space-2);
    padding: var(--space-2) var(--space-4);
    background: var(--color-panel);
    color: var(--color-text);
    font-size: var(--font-size-small);
    line-height: var(--line-height-small);
    text-decoration: none;
    transform: translateY(-200%);
  }

  .baseLayoutSkipLink:focus-visible {
    transform: none;
  }

  /* Focus lands here from the skip link; the outline would only frame the whole page. */
  .baseLayoutMain:focus {
    outline: none;
  }
</style>
