---
// One door: its story, POLARIS-7's log and the interview, from the door's page.yaml.
//
// Door gating: rendered on each request from GET /doors/{n}, never at build time, so a
// door's content can't be in the build before it opens. The API decides whether the door is
// open; this page only shows what it gets. A door that isn't open answers with exactly the
// 404 page, like a door that doesn't exist.
//
// A closed door shows when it opens, and how previewers log in: before Dec 1 that's the only
// place the site offers logging in. It says nothing about the door but its number and its
// opening time, which the schedule already makes public. A door that isn't in the schedule
// is the 404 page.
//
// When the API can't answer (down, or an open door's files unreadable), the page says to
// come back in a few minutes, with a 503 and no caching. That tells nobody more than the 404
// would: the API only fails this way for a door that's open, or for every door at once. Only
// doors in the schedule get there; any other number is a 404 without asking the API.
import Countdown from '../../components/Countdown.astro';
import TextPage from '../../components/TextPage.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { loginHref } from '../../lib/account';
import { doorCacheHeaders, doorDescription, fetchDoor, paragraphs } from '../../lib/doorPage';
import { formatStationTime, isDoor } from '../../lib/doors';

export const prerender = false;

const answer = await fetchDoor(import.meta.env.API_URL, Astro.params.door ?? '', isDoor);
const cacheHeaders = doorCacheHeaders(answer, new Date());
if (answer.state === 'missing') {
  // An empty 404 makes Astro answer with the prerendered 404 page.
  return new Response(null, { status: 404, headers: cacheHeaders });
}
if (answer.state === 'closed') {
  Astro.response.status = 404;
}
if (answer.state === 'unavailable') {
  Astro.response.status = 503;
  // Without a hint, crawlers and the CDN might come back whenever; a few minutes is right.
  Astro.response.headers.set('Retry-After', '120');
}
for (const [name, value] of Object.entries(cacheHeaders)) {
  Astro.response.headers.set(name, value);
}

const page = answer.state === 'open' ? answer.page : undefined;
const closed = answer.state === 'closed' ? answer : undefined;
// fetchDoor only answers for a door in the schedule, so the parameter is one here.
const number = String(page?.door ?? Astro.params.door).padStart(2, '0');
---

{
  page ? (
    <BaseLayout
      title={`door ${number} · ${page.title}`}
      description={doorDescription(page.story)}
      pola={{ mood: 'annoyed', message: `Door ${number} is open. Please do not break anything else.` }}
    >
      <TextPage command={`$ aocn open ${page.door}`} title={`door ${number} · ${page.title}`}>
        <div class="doorStory">
          {paragraphs(page.story).map((p) => (
            <p>{p}</p>
          ))}
        </div>
        {page.log && (
          <blockquote class="doorLog">
            {paragraphs(page.log).map((p) => (
              <p>{p}</p>
            ))}
            <footer class="doorLogSignature">— POLARIS-7</footer>
          </blockquote>
        )}
        {page.videoId && (
          <p>
            <a href={`https://www.youtube.com/watch?v=${encodeURIComponent(page.videoId)}`} target="_blank" rel="noopener">
              watch the interview
            </a>
          </p>
        )}
      </TextPage>
    </BaseLayout>
  ) : closed ? (
    <BaseLayout
      title={`door ${number}`}
      description={`Door ${number} opens ${formatStationTime(closed.opensAt)}.`}
      noindex
      pola={{ mood: 'neutral', message: 'This door opens when it opens. Not a minute earlier.' }}
    >
      <TextPage command={`$ aocn open ${closed.door}`} title={`door ${number}`}>
        <div class="doorClosed">
          <Countdown door={closed.door} />
          <p class="doorPreview" data-door={closed.door}>
            <span class="doorPreviewLogIn">
              previewing this door? <a href={loginHref(`/doors/${closed.door}`)}>log in</a>
            </span>
            <span class="doorPreviewLoggedIn" hidden></span>
          </p>
        </div>
      </TextPage>
    </BaseLayout>
  ) : (
    <BaseLayout
      title={`door ${number}`}
      description="This door can't be shown right now."
      noindex
      pola={{ mood: 'annoyed', message: 'Something is broken that is not you. For once.' }}
    >
      <TextPage command={`$ aocn open ${Number(number)}`} title={`door ${number} · stuck`}>
        <p>This door can't be shown right now. Try again in a few minutes.</p>
        <p>
          <a href="/">back home</a>
        </p>
      </TextPage>
    </BaseLayout>
  )
}

<script>
  import { fetchMe } from '../../lib/account';

  // Logged in already, but still here: not a previewer of this door, and logging in again
  // wouldn't change that.
  const preview = document.querySelector<HTMLElement>('.doorPreview');
  if (preview) {
    fetchMe().then((me) => {
      if (!me) return;
      const loggedIn = preview.querySelector<HTMLElement>('.doorPreviewLoggedIn')!;
      loggedIn.textContent = `logged in as @${me.login} · not a previewer of this door`;
      loggedIn.hidden = false;
      preview.querySelector<HTMLElement>('.doorPreviewLogIn')!.hidden = true;
    });
  }
</script>

<style>
  /* A feature panel, so the countdown's small labels stay readable over the aurora. */
  .doorClosed {
    display: grid;
    gap: var(--space-6);
    padding: var(--space-8);
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-screen);
    background: var(--color-panel-glass);
  }

  @media (max-width: 599px) {
    .doorClosed {
      padding: var(--space-6);
    }
  }

  .doorPreview {
    color: var(--color-text-soft);
    font-size: var(--font-size-small);
    line-height: var(--line-height-small);
  }

  .doorPreview a {
    color: var(--color-text);
  }

  /* Brighter than other text pages: a story is long enough to reach the aurora at tablet
     widths, where the body color falls below AA contrast. */
  .doorStory {
    display: grid;
    gap: var(--space-4);
    color: var(--color-text);
  }

  .doorLog {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding-left: var(--space-4);
    border-left: 1px solid var(--color-aurora);
    color: var(--color-text-soft);
  }

  .doorLogSignature {
    color: var(--color-muted);
    font-size: var(--font-size-small);
    line-height: var(--line-height-small);
  }
</style>
