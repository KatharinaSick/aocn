{
  // The Codespace for door 5, which the door's "play" link on aocn.dev opens. Written by
  // .github/scripts/devcontainers.sh, don't edit it by hand.
  //
  // The same as ../devcontainer.json, plus AOCN_DOOR: the image's postStartCommand
  // (aocn resume) opens door 5 on the first start, and starts it again on every start after
  // that. In a Codespace, it signs in a player who has an aocn.dev account already, so a
  // previewer gets the door early. Start commands never run in a prebuild, so no door is
  // downloaded before it opens.
  "name": "Advent of Cloud Native · door 05",
  "image": "ghcr.io/katharinasick/aocn-devcontainer:0.2.0",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}/play",
  "containerEnv": {
    "AOCN_WORKSPACE": "/workspaces/${localWorkspaceFolderBasename}/play",
    "AOCN_DOOR": "5"
  },
  "customizations": {
    "vscode": {
      "settings": {
        "files.exclude": {
          ".gitignore": true
        }
      }
    }
  }
}
