{
  // The Codespace for door 5, which the door's "play" link on aocn.dev opens. Written by
  // .github/scripts/devcontainers.sh, don't edit it by hand.
  //
  // The same as ../devcontainer.json, plus AOCN_DOOR: the image's postStartCommand
  // (aocn resume) opens door 5 on the first start, and starts it again on every start after
  // that. Before the door opens, a previewer signs in with aocn login and opens it with
  // aocn open 5. Start commands never run in a prebuild, so no door is downloaded before it
  // opens. On creation, it links play/README.md, the "your station is starting" page, to
  // door 5's page; git ignores that change, like the door's README later.
  "name": "Advent of Cloud Native · door 05",
  "image": "ghcr.io/katharinasick/aocn-devcontainer:0.4.0",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}/play",
  "containerEnv": {
    "AOCN_WORKSPACE": "/workspaces/${localWorkspaceFolderBasename}/play",
    "AOCN_DOOR": "5"
  },
  "postCreateCommand": "git update-index --skip-worktree README.md && sed -i 's|page: https://aocn.dev$|page: https://aocn.dev/doors/5|' README.md",
  "customizations": {
    "vscode": {
      "settings": {
        "files.exclude": {
          ".gitignore": true,
          ".open.json": true
        }
      }
    }
  }
}
