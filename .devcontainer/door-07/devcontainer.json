{
  // The Codespace for door 7, which the door's "play" link on aocn.dev opens. Written by
  // .github/scripts/devcontainers.sh, don't edit it by hand.
  //
  // The same as ../devcontainer.json, plus AOCN_DOOR: the image's postStartCommand
  // (aocn resume) opens door 7 on the first start, and starts it again on every start after
  // that. Before the door opens, a previewer signs in with aocn login and opens it with
  // aocn open 7. Start commands never run in a prebuild, so no door is downloaded before it
  // opens.
  "name": "Advent of Cloud Native · door 07",
  "image": "ghcr.io/katharinasick/aocn-devcontainer:0.2.2",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}/play",
  "containerEnv": {
    "AOCN_WORKSPACE": "/workspaces/${localWorkspaceFolderBasename}/play",
    "AOCN_DOOR": "7"
  },
  "postCreateCommand": "git update-index --skip-worktree README.md",
  "customizations": {
    "codespaces": {
      "openFiles": ["play/README.md"]
    },
    "vscode": {
      "settings": {
        "files.exclude": {
          ".gitignore": true,
          ".open.json": true,
          ".hints-seen.json": true
        }
      }
    }
  }
}
